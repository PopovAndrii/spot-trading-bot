# Template for src/.env
# Easiest: run `npm run setup-user` (it generates/writes everything below).
# Or copy this file to src/.env and fill the values manually.
#
# Infra vars (PORT, NGINX_PORT[_SSL], PREFIX_CONTAINER_NAME, STATUS_APP,
# STATUS_LOGIN) are NOT here — they have defaults in compose.yml. Add them to
# .env only if you need to override.

# production | development (development also starts the browser-sync dev server)
NODE_ENV=production

ADMIN_LOGIN=admin
# Generate the hash with:  npm run setup-user
# or manually: node -e "console.log(require('bcrypt').hashSync('your-password',10))"
# Keep the single quotes — the bcrypt hash contains '$' (Docker Compose would mangle it otherwise).
ADMIN_PASSWORD_HASH=''
SESSION_SECRET=''

# Which Binance to use: test | real (independent of NODE_ENV)
BINANCE_MODE=test

# Real keys — optional. If missing, the app falls back to testnet.
API_KEY=''
API_SECRET=''

# Test keys — required (used in testnet and as the safe fallback).
API_KEY_TEST=''
API_SECRET_TEST=''
