#!/usr/bin/env node

/**
 * Module dependencies.
 */

const app = require('../app');
const debug = require('debug')('www:server');
const http = require('http');
const path = require('path');
// const JsonTimerSender = require('../modules/jsonTimerSender');
const WebSocketRouter = require('../lib/websocketRouter');
const { scanLiveCycles } = require('../lib/recovery');
const { pair, statusPair } = require('../lib/pair');
const logBus = require('../lib/logBus');
/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3002');
app.set('port', port);

var server = http.createServer(app);

const wsRouter = new WebSocketRouter();

// Recovery scan (ANALYSIS.md item 1.5): the "running" state lives in memory and
// doesn't survive a restart. If data/ still has configs with live orders
// (NEW/PARTIALLY_FILLED + orderId) — they hang on the exchange, but no cycle walks
// them and the Save write-lock isn't in effect. We mark the symbol ATTENTION: Save
// is locked and the UI gets a warning on subscribe. Resume via the Start button
// (the whole cycle state is in the file), or cancel the orders.
scanLiveCycles(path.join(__dirname, '../data')).then((found) => {
  for (const { symbol, file, liveOrders } of found) {
    pair.addSymbol({ symbol, status: statusPair.ATTENTION });
    const msg = `⚠️ ${symbol}: ${liveOrders} live order(s) in ${file} after server restart — cycle NOT running, Save locked. Press Start to resume or cancel orders.`;
    console.warn(msg);
    logBus.log(msg);
  }
});

// Authorize the WebSocket handshake the same way HTTP routes are protected:
// run the shared session middleware on the upgrade request and require a
// logged-in session (unless STATUS_LOGIN=false). Without this, start/stop
// trading and the price stream were reachable by any socket, bypassing
// ensureAuthenticated (req 24 / 16).
const sessionMiddleware = app.get('sessionMiddleware');

server.on('upgrade', (req, socket, head) => {
  sessionMiddleware(req, {}, () => {
    const loginDisabled = process.env.STATUS_LOGIN === 'false';
    const authed = req.session && req.session.user;

    if (!loginDisabled && !authed) {
      socket.write('HTTP/1.1 401 Unauthorized\r\n\r\n');
      socket.destroy();
      return;
    }

    wsRouter.handleUpgrade(req, socket, head);
  });
});

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port, '0.0.0.0', () => {
  console.log('Server is running on port ' + port);

  // Dev live-reload: browser-sync proxies the REAL server (this one, which has
  // the WebSocketRouter) instead of a separate WS-less listener. `ws: true`
  // forwards WebSocket upgrades to the target so trading start/stop works on the
  // browser-sync port too. (req 23 — merged the two dev HTTP servers into one.)
  if (process.env.NODE_ENV === 'development') {
    const browserSync = require('browser-sync').create();
    browserSync.init({
      proxy: { target: 'http://localhost:' + port, ws: true },
      port: 3000,
      files: ['routes/*.js', 'views/*.ejs', 'public/**/*'],
      open: false,
      notify: false,
    });
  }
});
server.on('error', onError);
server.on('listening', onListening);

// Graceful shutdown (ANALYSIS item 12): docker stop sends SIGTERM (pm2-runtime
// forwards it). We close HTTP, stop the cycles/streams and let the current
// iterator pass finish writing (writes are atomic), then exit.
let shuttingDown = false;
function shutdown(signal) {
  if (shuttingDown) return;
  shuttingDown = true;

  console.log(`⏹️ ${signal} received — shutting down...`);

  server.close(() => console.log('HTTP server closed'));
  wsRouter.shutdown();

  // 3s for in-flight requests/writes to finish; docker gives 10s before SIGKILL
  setTimeout(() => process.exit(0), 3000).unref();
}

process.on('SIGTERM', () => shutdown('SIGTERM'));
process.on('SIGINT', () => shutdown('SIGINT'));

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
