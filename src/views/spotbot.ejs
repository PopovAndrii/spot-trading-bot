<!DOCTYPE html>
<html data-theme="">
<%- include('../views/head'); %>

  <body>
    <div class="wrapper">
      <header class="">
        <%- include('../views/navbar'); %>
      </header>
      <main class="container-adaptive content">
        <form>
          <div class="symbol">
            <div id="settings-strategy" class="input-btn">
              <input id="short" type="radio" name="btnradio">
              <label class="" for="short">short</label>
              <input id="long" type="radio" name="btnradio">
              <label class="" for="long">long</label>
            </div>

            <div class="symbol-bar">
              <div class="symbol-bar__text">
                <%= base + quote %>
              </div>
              <input type="" id="field-currency" disabled readonly>
            </div>
          </div>

          <div>
            <input type="hidden" id="field-strategy">
            <input type="hidden" id="field-tickSize">
            <input type="hidden" id="field-stepSize">
          </div>
          <div class="line">
            <div class="">
              <%- include('../views/ui/SpinBox', { id:'field-deposit' , label:'Available balance' , min: 0 , max: 0 ,
                step: formatInfo.tickSize || 0 }); %>
            </div>
            <div class="">
              <%- include('../views/ui/SpinBox', { id:'field-orderSize' , label:'Order Size' , min: 0 , max: 0 , step:
                formatInfo.stepSize || 0 }); %>
            </div>
            <div class="">
              <%- include('../views/ui/SpinBox', { id:'field-profit' , label:'Profit 0.1 - 0.4' , min: 0.1 , step: 1,
                max: 0 }); %>
            </div>
            <div class="">
              <%- include('../views/ui/SpinBox', { id:'field-fibonachiStep' , label:'Fibonachi step' , min: 0 , max: 0 ,
                step: 1 }); %>
            </div>
          </div>

          <div class="line">
            <div class="">
              <%- include('../views/ui/SpinBox', { id:'field-martingail' , label:'Martingail' , min: 50 , max: 150 ,
                step: 0 }); %>
            </div>
            <div class="">
              <%- include('../views/ui/SpinBox', { id:'field-indent' , label:'Indent price' , min:0.01, max:1 , step: 2
                }); %>
            </div>
            <div class="">
              <%- include('../views/ui/SpinBox', { id:'field-trackPrice' , label:'Track price' , min:0.1 , max:1, step:
                1, }); %>
            </div>
            <div class="">
              <%- include('../views/ui/SpinBox', { id:'field-requestFrequency' , label:'Request frequency' , min:1000,
                max:5000, step:0 }); %>
            </div>
          </div>

          <div class="line line-press -line-between">
            <button data-value="stumb" id="settings-calculate" class="UIb lg g-1 " type="button">Calculate
              <svg class="icon">
                <use href="/sprite.svg#calc"></use>
              </svg>
            </button>
            <button data-value="stumb" id="settings-calculate-save" class="UIb lg g-1 " type="button">Save
              <svg class="icon">
                <use href="/sprite.svg#save"></use>
              </svg>
            </button>

            <div class="stream-currency">
            </div>
            <div class="-line-line">
              <button data-value='{"base":"<%= base %>", "quote":"<%= quote %>"}' id="startBtn" type="button"
                class="UIb lg g-1 success">
                Start
                <svg class="icon">
                  <use href="/sprite.svg#play"></use>
                </svg>
              </button>
            </div>
          </div>

        </form>

        <table id="settings-table" class="t t-border t-striped t-hover">
          <thead>
            <tr>
              <th class="center">#</th>
              <th>%</th>
              <th>Buy currency</th>
              <th>BUY</th>
              <th>SELL</th>
              <th>Sell currency</th>
              <th>Spent. did buy</th>
              <th>Balance</th>
            </tr>
          </thead>
          <tbody>
          </tbody>
        </table>

        <div class="row">
          <div class="col">
            <div class="mb-1">
              <button href="#" data-value="<%= base + quote %>" id="cancel-all-orders" class="UIb lg g-1 danger"
                type="button">
                Cancel all <%= base + quote %> pairs
                  <svg class="icon">
                    <use href="/sprite.svg#close"></use>
                  </svg>
              </button>
            </div>
          </div>
        </div>
      </main>
      <%- include('../views/footer'); %>
        <div id="notifications"></div>
    </div>
  </body>
  <script>
    const base = '<%= base %>';
    const quote = '<%= quote %>';
    var orders = {};

  </script>
  <script type="module" src="/javascripts/spotMain.js"></script>

</html>