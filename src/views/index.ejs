<!DOCTYPE html>
<html data-theme="">
<%- include('../views/head'); %>

  <body>
    <div class="wrapper">
      <header class="">
        <%- include('../views/navbar'); %>
      </header>
      <main class="container-adaptive content">
        <div class="line justify-start align-end">

          <div class="self-stretch">
            <div class="UIselect lg expand info" id="selectCurrency" tabindex="0" role="listbox"
              aria-haspopup="listbox">
              <span class="UIselect-selected">Select Symbol</span>
              <span class="UIselect-arrow">
                <svg width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M7 12 1.4 5.6c-.7-.8-.1-2 1-2h11.5a1.2 1.2 0 0 1 .9 2L9 12.2q-.9.8-1.8 0" />
                </svg>
              </span>
              <input type="hidden" name="myId2">
              <ul class="UIselect-options" hidden>
                <li class="UIselect-options__search" role="search">
                  <input type="text" value="" aria-label="Search Symbol">
                </li>
                <li class="UIselect-options__items" aria-hidden="true">
                  <ul role="group">
                    <% info.symbols.forEach((name, index)=> { %>
                      <li role="option"
                        data-value='<%= name.symbol %>?base=<%= name.baseAsset %>&quote=<%= name.quoteAsset %>'>
                        <%= name.symbol %>
                      </li>
                      <% }); %>
                  </ul>
                </li>
              </ul>
            </div>
          </div>

          <div class="self-align-stretch">
            <a href="#" id="sendCurrency" class="button lg primary disabled">
              <svg class="icon">
                <use href="/sprite.svg#bun"></use>
              </svg>
              Select currency!
            </a>
          </div>
        </div>


      </main>
      <%- include('../views/footer'); %>
    </div>
  </body>
  <script type="module" src="/javascripts/indexMain.js"></script>

</html>