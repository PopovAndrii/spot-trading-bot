<!DOCTYPE html>
<html data-theme="">
<%- include('../views/head'); %>

  <body>
    <div class="wrapper">
      <header class="">
        <%- include('../views/navbar'); %>
      </header>
      <main class="container-adaptive content">
        <div class="line justify-start align-end">

          <div class="self-stretch">
            <div class="UIselect lg expand warning" id="selectCurrency" tabindex="0" role="listbox"
              aria-haspopup="listbox">
              <span class="UIselect-selected">Select Symbol</span>
              <span class="UIselect-arrow">
                <svg width="1em" height="1em" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M7 12 1.4 5.6c-.7-.8-.1-2 1-2h11.5a1.2 1.2 0 0 1 .9 2L9 12.2q-.9.8-1.8 0" />
                </svg>
              </span>
              <input type="hidden" name="myId2">
              <ul class="UIselect-options" hidden>
                <li class="UIselect-options__search" role="search">
                  <input type="text" value="" aria-label="Search Symbol">
                </li>
                <li class="UIselect-options__items" aria-hidden="true">
                  <ul role="group">
                    <% info.symbols.forEach((name, index)=> { %>
                      <li role="option"
                        data-value='<%= name.symbol %>'>
                        <%= name.symbol %>
                      </li>
                      <% }); %>
                  </ul>
                </li>
              </ul>
            </div>
          </div>

          <a href="#" id="sendCurrency" data-value="" class="UIb lg g-1 warning" aria-disabled="true">
            <span class="btn-label">Select currency!</span>
          </a>
        </div>

        <div class="server-address">
          Server address: <span>
            <%= serverIp || 'unavailable' %>
          </span>
        </div>

        <div class="api-keys">
          <% [['real', 'Real' ], ['test', 'Test' ]].forEach(([env, label])=> { const k = keys[env]; %>
            <div class="api-keys__group" data-env="<%= env %>">
              <div class="api-keys__title">
                <%= label %> keys in .env file:
                  <strong>
                    <%= k.present ? 'present' : 'missing' %>
                  </strong>
              </div>
              <div>key: <code><%= k.key ? k.key + '…' : '—' %></code></div>
              <div>secret: <code><%= k.secret ? k.secret + '…' : '—' %></code></div>
              <span>
                <button type="button" class="UIb -sm g-1" data-value="<%= env %>" data-check="<%= env %>" <%=k.present
                  ? '' : 'disabled' %>>
                  Check <%= label %>
                </button>
              </span>
              <span class="api-keys__status" aria-live="polite"></span>
            </div>
            <% }) %>
              <span>
                Get test keys <a href="https://testnet.binance.vision/" target="_blank">Binance Test keys</a>
              </span>
        </div>
      </main>
      <%- include('../views/footer'); %>
    </div>
  </body>
  <script type="module" src="/javascripts/indexMain.js"></script>

</html>