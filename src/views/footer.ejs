<script>
// function getPrice() {
//     socket.send(JSON.stringify({ type: 'price', symbol: 'BTCUSDT' }));
// }

const output = document.getElementById('output');
let socket;

function connectWebSocket() {
  socket = new WebSocket('ws://localhost:3000'); // замени порт, если другой

  socket.onopen = () => {
    output.textContent = '✅ Подключено\n';
    requestTime(); // Сразу запросить
    startAutoUpdate();
  };

  socket.onmessage = (event) => {
    try {
      const data = JSON.parse(event.data);
      if (data.type == 'time') {
        output.textContent = `🕒 Время Binance: ${data.time}`;
      }
    } catch (err) {
      console.error('❌ Ошибка парсинга:', err.message);
    }
  };

  socket.onerror = (err) => {
    console.error('Ошибка WebSocket:', err.message);
    output.textContent = '❌ Ошибка WebSocket';
  };

  socket.onclose = () => {
    output.textContent = '🔌 ...waiting connection...';
    setTimeout(connectWebSocket, 10000); // Автопереподключение
  };
}

function requestTime() {
  if (socket && socket.readyState === WebSocket.OPEN) {
    socket.send(JSON.stringify({ type: 'time' }));
  }
}

function startAutoUpdate() {
  setInterval(requestTime, 5000); // Запрашивать каждые 3 секунды
}

window.onload = () => {
  // connectWebSocket();
};
</script>