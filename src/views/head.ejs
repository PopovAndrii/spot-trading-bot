<head>
  <script>
    (function () {
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      } catch (e) { }
    })();
  </script>
  <title>
    <%= title %>
  </title>
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="alternate icon" type="image/png" href="/images/favicon.png">
  <link rel='stylesheet' href='/stylesheets/style.css' />
  <script src="/ui-elements/js/index.umd.js"></script>
  <link rel='stylesheet' href="/ui-elements/js/style.css" />
  <script type="module">
    import { SessionGuard } from '/javascripts/ui/SessionGuard.js';
    import { FooterStatus } from '/javascripts/ui/FooterStatus.js';
    import { ConsoleLog } from '/javascripts/ui/ConsoleLog.js';
    new SessionGuard();
    new FooterStatus();
    new ConsoleLog();
  </script>
</head>