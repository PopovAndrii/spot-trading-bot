<script>
  async function fetchActiveSymbols() {
    const res = await fetch('/api/symbols');
    const symbols = await res.json();

    const ddown = document.querySelector('#main-menu .ddown-menu');

    for (const [key, value] of symbols.entries()) {
      const a = document.createElement('a');

      var status = '';

      if (value.status != 0) {
        status = value.status == 1 ? 'running' : 'pause';
      }

      a.href = `/spotbot/${value.symbol}?base=${value.base}&quote=${value.quote}`;
      a.textContent = `${value.symbol} ${status}`;

      ddown.appendChild(a);
    }
  }

  fetchActiveSymbols();
</script>