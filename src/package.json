{
  "name": "Binance Trading bot",
  "version": "1.1.3",
  "private": true,
  "scripts": {
    "build-css": "sass scss/:public/stylesheets/ --no-source-map",
    "gen-qr": "node ./tools/gen-qr.js",
    "dev": "concurrently \"npm:watch-css\" \"npm:start\"",
    "start": "nodemon ./bin/www",
    "setup-user": "node ./bin/setup-user.js",
    "test": "node --test",
    "prod-runtime": "pm2-runtime start ./bin/www --name my-app",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"scss/**/*.scss\"",
    "lint:css:fix": "stylelint \"scss/**/*.scss\" --fix",
    "watch-css": "sass --style=compressed --no-source-map --watch scss/:public/stylesheets/"
  },
  "dependencies": {
    "@binance/connector": "^3.6.1",
    "@popovandrii/ui-elements": "^0.5.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "~1.4.7",
    "debug": "~4.4.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "helmet": "^8.2.0",
    "http-errors": "~2.0.1",
    "morgan": "^1.11.0",
    "pm2": "^7.0.1",
    "session-file-store": "^1.5.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@stylistic/stylelint-config": "^5.0.0",
    "@stylistic/stylelint-plugin": "^5.2.1",
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "js-beautify": "^2.0.3",
    "nodemon": "^3.1.14",
    "qrcode": "^1.5.4",
    "sass": "^1.101.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-scss": "^17.0.0"
  }
}
