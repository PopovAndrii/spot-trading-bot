{
  "name": "www",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build-css": "sass scss/:public/stylesheets/ --no-source-map",
    "dev": "concurrently \"npm:watch-css\" \"npm:start\"",
    "start": "nodemon ./bin/www",
    "prod-start": "pm2 start ./bin/www --name 'my-app' --env production",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "watch-css": "sass --style=compressed --no-source-map --watch scss/:public/stylesheets/"
  },
  "dependencies": {
    "@binance/connector": "^3.6.1",
    "@popovandrii/ui-elements": "^0.1.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "~1.4.7",
    "debug": "~4.4.3",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "http-errors": "~2.0.1",
    "morgan": "^1.10.1",
    "node-fetch": "^3.3.2",
    "pm2": "^7.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "sass": "^1.100.0"
  }
}