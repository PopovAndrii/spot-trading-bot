#!/bin/bash

######################################
# Create temporary folders for data.
# redis postgres app(logs)
######################################
if [[ -d ./tmp/ ]]; then
	echo 'OK ./tmp'
else
	read -p 'The .tmp (.tmp/app) folder does`not exist. Create [y/n]' tmp_folder
	if [[ $tmp_folder = 'y' ]] && [[ ! -z $tmp_folder ]]; then
		mkdir -vp ./tmp/app
	fi
fi

#######################################
# Create .bash_istory file
# History of executed commands
# Search: Ctrl + r and arrow Up & Down
#######################################
if [[ ! -f .bash_history ]]; then
	read -p 'The command history file does not exist. Create file? [y/n]' bash_history
	if [[ $bash_history = 'y' ]] && [[ -n $bash_history ]]; then
		echo '
composer install
npm install
npm run watch' >> .bash_history
		echo 'Created .bash_history file'
	fi
else
	echo 'OK .ash_history'
fi

# Create simbolic link .env file
if [[ ! -L .env ]]; then
	read -p 'The .env file is not symbolic link or does`not exist. Create link? [y/n]' env_symlink
	if [[ $env_symlink = 'y' ]] && [[ ! -z $env_symlink ]]; then
		ln -sf ./src/.env ./.env
		echo 'Created .env Symbolic link'
	fi
else
	echo 'OK .env'
fi

#######################################
# Check Docker Compose version.
# env_file "required: false" needs Compose >= 2.24, so the container can start
# without a .env (setup-user creates it). Older versions need an empty .env first.
#######################################
compose_ver=$(docker compose version --short 2>/dev/null | sed 's/^v//')
if [[ -z $compose_ver ]]; then
	echo '⚠️  docker compose not found — skipping version check.'
	echo '    If "env_file" fails on start, run: touch ./src/.env'
else
	ver_major=${compose_ver%%.*}
	ver_rest=${compose_ver#*.}
	ver_minor=${ver_rest%%.*}
	if (( ver_major > 2 || (ver_major == 2 && ver_minor >= 24) )); then
		echo "OK docker compose $compose_ver (env_file required:false supported)"
	else
		echo "⚠️  docker compose $compose_ver < 2.24 — env_file 'required: false' is not supported."
		echo '    Without a .env the container will not start.'
		read -p 'Create an empty ./src/.env now (so it can start)? [y/n]' mk_env
		if [[ $mk_env = 'y' ]] && [[ -n $mk_env ]]; then
			touch ./src/.env
			echo 'Created empty ./src/.env'
		fi
	fi
fi
